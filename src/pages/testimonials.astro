.TestimonialsMian:before{content:'';position:absolute;top:50%;left:50%;width:99999px;height:99999px;transform:translate(-50%,-50%) rotate(0deg);background-repeat:no-repeat;background-position:0 0;z-index:0;animation:rotate 4s linear infinite;}
.TestimonialsMian:hover::before{background-image:conic-gradient(rgba(0,0,0,0),#2e8ece,rgba(255,228,11,0) 25%);}
.TestimonialsMian:hover .Testishape{background:#2e8ece!important;} 

.testiHover{position:absolute;bottom:7px;right:-13px;opacity:0;}
.testiHover img{width:32px;}
.TestimonialsMian:hover .testiHover{opacity:1;} 

.testiPhoto{position:relative;}
.testiPhoto figure{position:relative;z-index:1;overflow:hidden;}
.testiPhoto figure img{border-radius:20px;}
.testiPhoto figure::after{content:'';position:absolute;width:200%;height:0;left:50%;top:50%;background-color:rgba(255,255,255,.3);transform:translate(-50%,-50%) rotate(-45deg);}
.TestimonialsMian:hover .testiPhoto figure::after{height:250%;transition:all 600ms linear!important;background-color:transparent;} 

.quoteTesti img{width:33px;} 

.lineTesti{width:92px;height:3px;background:#1889d5;display:inline-block;position:relative;top:0;margin:10px 0 12px;} 

.testiContent h3{margin:0;} 

.testiname strong{display:block;}
.testiname{line-height:20px;} 

.Testishape{background:linear-gradient(45deg,var(--primary) 0%,var(--secondary) 100%);animation:morph 8s ease-in-out infinite;border-radius:60% 40% 30% 70%/60% 30% 70% 40%;height:70px;transition:all 1s ease-in-out;width:70px;z-index:5;background:#dda1ff!important;position:absolute;right:10px;bottom:-50px;} 

@keyframes rotate{0%{transform:translate(-50%,-50%) rotate(0deg);}100%{transform:translate(-50%,-50%) rotate(360deg);}} 

@keyframes morph{0%{border-radius:60% 40% 30% 70%/60% 30% 70% 40%;background:linear-gradient(45deg,var(--primary) 0%,var(--secondary) 100%);}50%{border-radius:30% 60% 70% 40%/50% 60% 30% 60%;background:linear-gradient(45deg,var(--third) 0%,var(--secondary) 100%);}100%{border-radius:60% 40% 30% 70%/60% 30% 70% 40%;background:linear-gradient(45deg,var(--primary) 0%,var(--secondary) 100%);}} 

@media(max-width:767px){.testiPhoto figure{margin:0 0 12px;}.testiContent h3{font-size:21px;}} 


</style>

